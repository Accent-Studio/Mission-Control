@echo off
rem Keeps every cache and temp location inside this folder, so nothing lands in AppData.
set "WAKETRAINER_ROOT=%~dp0"
if "%WAKETRAINER_ROOT:~-1%"=="\" set "WAKETRAINER_ROOT=%WAKETRAINER_ROOT:~0,-1%"
set "PIP_CACHE_DIR=%WAKETRAINER_ROOT%\cache\pip"
set "HF_HOME=%WAKETRAINER_ROOT%\cache\hf"
set "HF_HUB_CACHE=%WAKETRAINER_ROOT%\cache\hf\hub"
set "TORCH_HOME=%WAKETRAINER_ROOT%\cache\torch"
set "UV_CACHE_DIR=%WAKETRAINER_ROOT%\cache\uv"
set "TEMP=%WAKETRAINER_ROOT%\tmp"
set "TMP=%WAKETRAINER_ROOT%\tmp"
set "TMPDIR=%WAKETRAINER_ROOT%\tmp"
set "XDG_CACHE_HOME=%WAKETRAINER_ROOT%\cache"
set "PYTHONIOENCODING=utf-8"
set "PYTHONUTF8=1"
set "PIP_DISABLE_PIP_VERSION_CHECK=1"
set "HF_HUB_DISABLE_TELEMETRY=1"
set "PYTHONNOUSERSITE=1"
set "ESPEAK_DATA_PATH=%WAKETRAINER_ROOT%\tools\espeak-ng"
set "PATH=%WAKETRAINER_ROOT%\.venv\Scripts;%WAKETRAINER_ROOT%\tools\espeak-ng;%PATH%"
