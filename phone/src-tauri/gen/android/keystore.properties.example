# Copy this file to keystore.properties (same folder, never in git) to sign release APKs with your own key.
# Make a key once with the JDK's keytool, for example:
#   keytool -genkeypair -v -keystore D:/Keys/missioncontrol-phone.jks -alias missioncontrol -keyalg RSA -keysize 4096 -validity 36500
# Keep the key and its password safe: every update of the app must be signed with the same key.
password=change-me
keyAlias=missioncontrol
storeFile=D:/Keys/missioncontrol-phone.jks
